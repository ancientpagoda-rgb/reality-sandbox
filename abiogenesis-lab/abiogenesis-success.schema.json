{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ancientpagoda-rgb.github.io/reality-sandbox/abiogenesis-lab/abiogenesis-success.schema.json",
  "title": "Abiogenesis Success Record",
  "type": "object",
  "required": ["schemaVersion", "kind", "id", "classification", "abiogenesisTime", "seed", "producingCommit", "model", "configuration", "verification", "evidence"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "abiogenesis-success" },
    "id": { "type": "string", "pattern": "^abiogenesis-[a-f0-9]{20}$" },
    "recordedAt": { "type": "string", "format": "date-time" },
    "classification": { "enum": ["sustained-darwinian-system", "cellular-life"] },
    "abiogenesisTime": { "type": "number", "minimum": 0 },
    "seed": {},
    "numericSeed": { "type": "integer" },
    "producingCommit": { "type": "string", "minLength": 7 },
    "model": {
      "type": "object",
      "required": ["name", "version", "detectorSchemaVersion"],
      "properties": {
        "name": { "const": "abiogenesis-lab" },
        "version": { "type": "string" },
        "detectorSchemaVersion": { "type": "integer", "minimum": 1 }
      }
    },
    "configuration": { "type": "object" },
    "verification": {
      "type": "object",
      "required": ["lifeDetected", "termination", "qualification", "terminalClassification"],
      "properties": {
        "lifeDetected": { "const": true },
        "termination": { "const": "life-detected" },
        "qualification": { "const": "detector-qualified" },
        "terminalClassification": { "enum": ["sustained-darwinian-system", "cellular-life"] }
      }
    },
    "evidence": { "type": "object" },
    "metrics": { "type": "object" },
    "evolution": { "type": "object" },
    "terminalDetection": {},
    "steps": { "type": "integer", "minimum": 0 },
    "sourceBatch": { "type": ["string", "null"] }
  },
  "additionalProperties": true
}
